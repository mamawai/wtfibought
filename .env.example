# ============================================================
# WhatIfIBought 环境配置模板（唯一需要手工填值的文件）
#
#   本地开发: cp .env.example .env.local 填值
#             之后 IDEA 直接点 Run，或 ./start-local.ps1 一键起三服务
#   线上部署: 服务器上命名为 .env 放 compose 同目录，容器自动注入
#
#   只有 PG_USER / PG_PASSWORD / INTERNAL_API_TOKEN 必填（缺了启动即报 placeholder 错误）
#   其余不填走默认值也能启动，对应功能降级
#   注意: 注释必须独立成行，行内注释会被当成值的一部分
# ============================================================

# ---- PostgreSQL（必填）----
# docker 部署 HOST 填容器名(如 postgres)或宿主机内网 IP，写 localhost 会指向容器自己
PG_HOST=localhost
PG_PORT=5432
PG_DB=wiib
PG_USER=
PG_PASSWORD=

# ---- Redis ----
# HOST 填法同上；无密码留空
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- Redis 主从-哨兵（可选，线上高可用，配合 redis-compose.yml 栈）----
# 放开下一行即切哨兵模式（REDIS_HOST/PORT 被忽略，PASSWORD/DB 照常生效）
# 哨兵节点默认 redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379，非默认才需填 REDIS_SENTINEL_NODES
# SPRING_PROFILES_ACTIVE=sentinel
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=

# ---- LinuxDo OAuth（可选，不配则关闭 LinuxDo 登录）----
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=http://localhost:3000/login

# ---- 账号密码登录 + 邀请码注册（可选，与 LinuxDo 并存）----
# 开启后登录页出现"账号密码 + 邀请码注册"入口，同时管理员直登自动关闭
# ADMIN_PASSWORD = 给管理员账号(id=1)设的登录密码
# 必须配它：邀请码只有管理员能生成，id=1 没密码就没人能进 Admin 页生成码，谁也注册不了
# id=1 是谁：全新库=自动创建的 admin；已有 LinuxDo 的库=首个 OAuth 用户，用其用户名+此密码登录
PASSWORD_LOGIN_ENABLED=false
ADMIN_PASSWORD=

# ---- Binance USDT-M Testnet（可选，策略 testnet 轨下单用；不填仅 sim 模拟盘轨可用）----
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ---- BlockBeats 快讯（可选，不填新闻功能降级）----
BLOCKBEATS_API_KEY=

# ---- 内部服务间鉴权 token（必填，feed/sim/agent 三进程须同值）----
# /internal/** 服务间调用的鉴权凭据，无默认值，不填三进程都起不来：
#   openssl rand -base64 24
INTERNAL_API_TOKEN=

# ---- AI Trader（BYOK 竞技场）----
# 用户 apiKey 的 AES-GCM 加密密钥（base64 32字节），不填则无法创建 trader；每环境单独生成勿复用：
#   openssl rand -base64 32
WIIB_TRADER_KEY_SECRET=
# baseUrl SSRF 白名单（可选，逗号分隔主机名）：默认拒绝内网/本机地址，
# docker 同网络的代理网关（如 cliproxyapi）在这里放行
# WIIB_TRADER_BASEURL_ALLOWLIST=cliproxyapi

# ---- 平台 Jev（TypeSafe System One；只给预测员用，不走 BYOK）----
# 不填：预测员不启动；填了预测员也默认关，去 /admin 页面打开。研判工作台的 Jev 路由走用户各自的配置，与此无关
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest

# ---- 时区（可选，仅 docker 部署用，默认 Asia/Singapore）----
# TZ=Asia/Shanghai

# ---- LDC 瓜分活动（可选，不配则关闭发放）----
LDC_CLIENT_ID=
LDC_CLIENT_SECRET=
LDC_ENABLED=false
