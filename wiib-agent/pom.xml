<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mawai</groupId>
        <artifactId>whatifibought</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>wiib-agent</artifactId>
    <name>wiib-agent</name>
    <description>AI 交易员应用：LLM 研判/对话/复盘/学习，经 wiib-quant 拿行情与量化能力；唯一可执行进程，量化侧 controller 也由它挂载</description>
    <packaging>jar</packaging>

    <properties>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 钉死 spring-ai 全家版本：starter / retry 与任何传递进来的 spring-ai 模块都走同一个号 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 量化能力库：策略/回测/研究/行情/交易所客户端，传递 wiib-common(web/redis/aop/sa-token/mybatis-plus/fastjson2/caffeine) -->
        <dependency>
            <groupId>com.mawai</groupId>
            <artifactId>wiib-quant</artifactId>
        </dependency>

        <!-- Spring AI OpenAI Starter（接入 OpenAI Compatible API）；叶子 agent 的 ReAct 循环是 llm/ReactLoop 手写的，不引图引擎 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- Transient/NonTransientAiException：2.0 起不再随 starter 传递，ResponsesChatModel 的错误分类要用 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-retry</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- WebFlux：LLM API 调用（spring-ai openai 底层 WebClient） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Caffeine L1 本地缓存（agent 热缓存） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- 本地观测：Graph 节点耗时/异常指标 + Prometheus 导出 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
