<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mawai</groupId>
        <artifactId>whatifibought</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>wiib-quant</artifactId>
    <name>wiib-quant</name>
    <description>量化能力库：策略/回测/研究/行情/交易所客户端 + 各自的 HTTP 门面。不是可执行进程，由 wiib-agent 依赖并扫描挂载</description>
    <packaging>jar</packaging>

    <!-- 注意：这里不能挂 spring-boot-maven-plugin，否则 repackage 出的 fat jar 依赖不到 -->

    <dependencies>
        <!-- 共享层：行情通道/缓存/REST客户端/entity/mapper/基础设施config 全在这（传递 web/redis/aop/sa-token/mybatis-plus/fastjson2/caffeine） -->
        <dependency>
            <groupId>com.mawai</groupId>
            <artifactId>wiib-common</artifactId>
        </dependency>

        <!-- fastjson2：market/external/strategy/research 落库与解析重度使用，BOM 管版本 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- PostgreSQL：quant mapper 落库（日历 / 快讯 / 策略信号） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
    </dependencies>

</project>
